FROM ubuntu:22.04

RUN apt-get update -y \
    && apt-get upgrade -y \
    && apt-get install -y curl gnupg wget git vim 

COPY . /root/AnnoTEP
COPY Scripts/break_fasta.pl /usr/local/bin/

#Install miniconda
RUN wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh \
    && mkdir /root/.conda \
    && bash Miniconda3-latest-Linux-x86_64.sh -b \
    && rm -f Miniconda3-latest-Linux-x86_64.sh

# Setting environment variables
ENV CONDA_PREFIX=/root/miniconda3
ENV PATH="/root/miniconda3/bin:$PATH" 
ENV PATH="/usr/bin:$PATH"

#Install EDTA
RUN cd /root/AnnoTEP \
    && conda env create -f environment.yml

# Config UTF-8 for Flask
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

# Port Flask
EXPOSE 5000

# Work directory
WORKDIR /root/AnnoTEP/graphic-interface

# Create a volume called “results” and set it as the container's mount point
VOLUME /root/AnnoTEP/graphic-interface/results

# Command to start Flask and synchronize the folder
CMD ["bash", "-c", "source /root/miniconda3/etc/profile.d/conda.sh && conda activate EDTA-new && flask run --host=0.0.0.0 --port=5000"]
#CMD ["/bin/bash", "-c", "export LC_ALL=C.UTF-8 && export LANG=C.UTF-8 && flask run --host=0.0.0.0"]






