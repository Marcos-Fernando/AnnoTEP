FROM ubuntu:22.04

# Instala pacotes básicos
RUN apt-get update -y \
    && apt-get upgrade -y \
    && apt-get install -y curl gnupg wget git vim

# Copia código-fonte
COPY . /usr/local/AnnoTEP
COPY Scripts/break_fasta.pl /usr/local/bin/

# Instala o Miniconda em diretório compatível com Singularity
RUN wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh \
    && bash Miniconda3-latest-Linux-x86_64.sh -b -p /usr/local/miniconda3 \
    && rm -f Miniconda3-latest-Linux-x86_64.sh

# Variáveis de ambiente do Conda
ENV CONDA_PREFIX=/usr/local/miniconda3
ENV PATH="/usr/local/miniconda3/bin:$PATH"

# Cria e ativa o ambiente Conda com EDTA e dependências
RUN cd /usr/local/AnnoTEP \
    && conda env create -f environment.yml

# Configuração de UTF-8
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

# Porta do Flask
EXPOSE 5000

# Define diretório de trabalho
WORKDIR /usr/local/AnnoTEP/graphic-interface

# Diretório para resultados com permissões de escrita
VOLUME /usr/local/AnnoTEP/graphic-interface/results

# Comando de inicialização do Flask com ambiente Conda ativado
CMD ["bash", "-c", "source /usr/local/miniconda3/etc/profile.d/conda.sh && conda activate EDTA-new && flask run --host=0.0.0.0 --port=5000"]
